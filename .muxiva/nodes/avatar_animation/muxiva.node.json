{
  "format": "muxiva.node/v1",
  "package_id": "avatar_animation",
  "display_name": "Audio-driven Avatar Animation",
  "node_type": "avatar.animation",
  "language": "python",
  "factory_version": "1.0.0",
  "kind": "transform",
  "entrypoint": "node:AvatarAnimationNode",
  "category": "media",
  "capability": "avatar.animation.envelope",
  "summary": "Converts PCM into bounded, sample-timed mouth-opening events. RMS envelope, not phoneme recognition.",
  "ports": [
    {"name": "audio_in", "direction": "input", "frame_type": "audio", "schema": {"encoding": "pcm_s16le", "streaming": true}},
    {"name": "signal_in", "direction": "input", "frame_type": "signal"},
    {"name": "event_out", "direction": "output", "frame_type": "event", "schema": {"streaming": true}}
  ],
  "config_schema": {
    "type": "object",
    "properties": {
      "stream_id": {"type": "string", "default": "assistant"},
      "window_ms": {"type": "integer", "minimum": 5, "maximum": 100, "default": 20},
      "floor_db": {"type": "number", "default": -48},
      "ceiling_db": {"type": "number", "default": -15},
      "cancel_signal_names": {"type": "array", "items": {"type": "string"}, "default": ["muxiva.playback.cancelled"]}
    },
    "additionalProperties": false
  }
}
