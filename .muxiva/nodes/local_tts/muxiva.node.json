{
  "format": "muxiva.node/v1",
  "package_id": "local_tts",
  "display_name": "Local Sherpa CPU TTS",
  "node_type": "muxiva.local_tts",
  "language": "python",
  "factory_version": "1.0.0",
  "kind": "transform",
  "entrypoint": "node:LocalTtsNode",
  "category": "algorithm",
  "capability": "speech.synthesis.local",
  "summary": "Cancellable Kokoro, Melo or configured Matcha CPU synthesis. Resamples to 24 kHz and preserves response sequence and sample timestamps.",
  "tags": [
    "local",
    "cpu",
    "windows",
    "kokoro",
    "tts",
    "melo",
    "matcha"
  ],
  "ports": [
    {
      "name": "text_in",
      "direction": "input",
      "frame_type": "text",
      "schema": {
        "semantics": [
          "speakable_text"
        ],
        "streaming": true
      }
    },
    {
      "name": "signal_in",
      "direction": "input",
      "frame_type": "signal",
      "schema": {
        "semantics": [
          "turn_cancellation"
        ],
        "signal_names": [
          "muxiva.turn.cancelled"
        ]
      }
    },
    {
      "name": "audio_out",
      "direction": "output",
      "frame_type": "audio",
      "schema": {
        "encoding": "pcm_s16le",
        "sample_rate_hz": 24000,
        "channels": 1,
        "streaming": true
      }
    },
    {
      "name": "event_out",
      "direction": "output",
      "frame_type": "event",
      "schema": {
        "semantics": [
          "synthesis_state"
        ],
        "streaming": true
      }
    }
  ],
  "config_schema": {
    "type": "object",
    "properties": {
      "model_dir": {
        "type": "string",
        "default": ""
      },
      "acoustic_model": {
        "type": "string",
        "description": "Matcha acoustic ONNX path, absolute or relative to model_dir. Required for Matcha.",
        "minLength": 1
      },
      "vocoder": {
        "type": "string",
        "description": "Matcha vocoder ONNX path, absolute or relative to model_dir. Required for Matcha.",
        "minLength": 1
      },
      "rule_fsts": {
        "type": "array",
        "description": "Ordered normalization FST paths, absolute or relative to model_dir.",
        "maxItems": 16,
        "uniqueItems": true,
        "items": {"type": "string", "minLength": 1}
      },
      "silence_scale": {
        "type": "number",
        "description": "Optional Sherpa silence scaling. Omit to retain its existing default; 1 preserves audition silence timing.",
        "minimum": 0,
        "maximum": 2
      },
      "language": {
        "type": "string",
        "default": "auto"
      },
      "speaker_id": {
        "type": "integer",
        "default": 3,
        "minimum": 0,
        "maximum": 102
      },
      "speed": {
        "type": "number",
        "default": 1,
        "minimum": 0.5,
        "maximum": 2
      },
      "num_threads": {
        "type": "integer",
        "default": 4,
        "minimum": 1,
        "maximum": 8
      },
      "voice_effect": {
        "type": "object",
        "description": "Optional local FFmpeg Rubber Band pitch/tempo tuning before audio_out. Omit for original voice; requires an FFmpeg build with rubberband.",
        "properties": {
          "pitch_semitones": {"type": "number", "minimum": -6, "maximum": 6, "default": 0},
          "tempo": {"type": "number", "minimum": 0.75, "maximum": 1.5, "default": 1},
          "ffmpeg": {"type": "string", "minLength": 1, "description": "Executable path/name. Defaults to MUXIVA_FFMPEG or ffmpeg on PATH."}
        },
        "additionalProperties": false
      },
      "pcm_chunk_ms": {
        "type": "integer",
        "default": 40,
        "minimum": 10,
        "maximum": 100
      },
      "max_pending_segments": {
        "type": "integer",
        "default": 32,
        "minimum": 1,
        "maximum": 128
      },
      "max_audio_chunks": {
        "type": "integer",
        "default": 64,
        "minimum": 8,
        "maximum": 256
      },
      "max_segment_chars": {
        "type": "integer",
        "default": 600,
        "minimum": 20,
        "maximum": 2000
      },
      "backend": {
        "type": "string",
        "enum": [
          "kokoro-int8",
          "kokoro",
          "melo",
          "matcha"
        ],
        "default": "kokoro"
      }
    },
    "additionalProperties": false
  }
}
