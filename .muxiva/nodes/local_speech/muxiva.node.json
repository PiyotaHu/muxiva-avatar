{
  "format": "muxiva.node/v1",
  "package_id": "local_speech",
  "display_name": "Local Silero + Hybrid ASR",
  "node_type": "muxiva.local_speech",
  "language": "python",
  "factory_version": "1.0.0",
  "kind": "transform",
  "entrypoint": "node:LocalSpeechNode",
  "category": "algorithm",
  "capability": "speech.recognition.local",
  "summary": "CPU Silero VAD, Zipformer previews and SenseVoice finals. Emits observations; the voice controller owns interruption decisions.",
  "tags": [
    "local",
    "cpu",
    "windows",
    "vad",
    "asr"
  ],
  "ports": [
    {
      "name": "audio_in",
      "direction": "input",
      "frame_type": "audio",
      "schema": {
        "encoding": "pcm_s16le",
        "sample_rate_hz": 16000,
        "channels": 1,
        "streaming": true
      }
    },
    {
      "name": "signal_in",
      "direction": "input",
      "frame_type": "signal",
      "schema": {
        "semantics": [
          "microphone_mute",
          "decoder_reset"
        ]
      }
    },
    {
      "name": "speech_out",
      "direction": "output",
      "frame_type": "event",
      "schema": {
        "semantics": [
          "speech_started",
          "speech_stopped"
        ]
      }
    },
    {
      "name": "transcript_preview_out",
      "direction": "output",
      "frame_type": "text",
      "schema": {
        "semantics": [
          "partial_transcript"
        ],
        "streaming": true
      }
    },
    {
      "name": "text_out",
      "direction": "output",
      "frame_type": "text",
      "schema": {
        "semantics": [
          "final_transcript"
        ],
        "streaming": false
      }
    },
    {
      "name": "event_out",
      "direction": "output",
      "frame_type": "event",
      "schema": {
        "semantics": [
          "speech_state",
          "transcript"
        ]
      }
    }
  ],
  "config_schema": {
    "type": "object",
    "properties": {
      "model_dir": {
        "type": "string",
        "default": ".models/asr-zh"
      },
      "final_model_dir": {
        "type": "string",
        "default": ".models/sherpa-onnx-sense-voice-zh-en-ja-ko-yue-int8-2024-07-17"
      },
      "vad_model": {
        "type": "string",
        "default": ".models/silero_vad.onnx"
      },
      "final_language": {
        "type": "string",
        "default": "auto"
      },
      "final_use_itn": {
        "type": "boolean",
        "default": true
      },
      "accepted_final_languages": {
        "type": "array",
        "default": [
          "zh",
          "en"
        ],
        "items": {
          "type": "string"
        }
      },
      "min_final_chars": {
        "type": "integer",
        "default": 1,
        "minimum": 1,
        "maximum": 16
      },
      "num_threads": {
        "type": "integer",
        "default": 2,
        "minimum": 1,
        "maximum": 8
      },
      "final_num_threads": {
        "type": "integer",
        "default": 2,
        "minimum": 1,
        "maximum": 8
      },
      "vad_threshold": {
        "type": "number",
        "default": 0.75,
        "minimum": 0,
        "maximum": 1
      },
      "min_silence_seconds": {
        "type": "number",
        "default": 0.8,
        "minimum": 0.1,
        "maximum": 3
      },
      "min_speech_seconds": {
        "type": "number",
        "default": 0.2,
        "minimum": 0.05,
        "maximum": 2
      },
      "pre_roll_seconds": {
        "type": "number",
        "default": 0.5,
        "minimum": 0,
        "maximum": 1.5
      },
      "max_speech_seconds": {
        "type": "number",
        "default": 30,
        "minimum": 3,
        "maximum": 120
      }
    },
    "additionalProperties": false
  }
}
